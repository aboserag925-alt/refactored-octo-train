OPENAI_API_KEY=put_your_key_here
OPENAI_PROJECT_ID=proj_pztv7NZUGVHEzy2suKX5KU3N
OPENAI_MODEL=gpt-6-astra
PORT=3000
HOST=127.0.0.1
# Optional on localhost; required (8+ characters) when HOST is not loopback.
ACCESS_PASSWORD=
DAILY_LIMIT=200
ENABLE_SHELL=0
# Optional read-only Gmail OAuth integration. See GMAIL_SETUP_AR.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_URL=http://localhost:3000
# Optional: override the default assistant instructions.
# AGENT_INSTRUCTIONS=You are أبو سراج, a helpful personal assistant. Respond in Arabic by default.


# Optional: Android phone tools through Termux:API (see PHONE_SETUP_AR.md). Needs the server to run on the phone.
ENABLE_PHONE=0
# Only behind a reverse proxy you control:
TRUST_PROXY=0
